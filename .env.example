# JWT signing secret (REQUIRED in production)
# In development a random secret is generated automatically.
# Generate one with: openssl rand -base64 32
JWT_SECRET=replace-me-with-a-long-random-string

# Frontend origin (used for CORS + Socket.IO cors)
# Local dev:    http://localhost:5173
# Production:   https://your-deployment.example.com
# Defaults to http://localhost:5173 if unset
FRONTEND_URL=http://localhost:5173

# Runtime mode — controls dev secret generation, error verbosity, etc.
# Values: development | production
NODE_ENV=development

# Note: the backend port is passed as a CLI argument, not an env var.
# Local:      node --watch src/server.js 3000
# Railway:    PORT is supplied to the start command in railway.json
